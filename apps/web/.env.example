# Copy to .env.local and adjust. Never commit a filled-in .env.local.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Development only. Until sign-in exists, gives each browser a random user id
# in a cookie and sends it to the API as the bearer token (#119). Without it
# every API call is a 401. Never set this on a deployed site: whoever holds the
# cookie is that user.
NEXT_PUBLIC_DEV_SESSION=1
