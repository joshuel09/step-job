# Copy to .env and adjust. Never commit a filled-in .env.
DATABASE_URL=postgresql+psycopg://stepjob:stepjob@localhost:5432/stepjob
ENVIRONMENT=local

# Host ports for local services; override if these are already taken.
POSTGRES_PORT=5432
REDIS_PORT=6379

# Which model provider to use: "fake" or "openai". "fake" keeps local work and
# continuous integration off the network.
AI_PROVIDER=fake
# Only read when AI_PROVIDER=openai.
OPENAI_API_KEY=

# Where the web app is served from. The API and the interface are separate
# origins, so a wrong value means the browser is refused. Separate several with
# commas.
WEB_ORIGINS=http://localhost:3000
